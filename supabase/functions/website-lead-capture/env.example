# Names only. Do not put secret values in git.
# supabase secrets set --project-ref hzllfwqnsiirlwacaitt NAME
# Copy TURNSTILE_SECRET from the workstation env file. Do not paste it here.

TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=akwmarketing.pages.dev

# Both stay false. Slack still does not post (sendImplemented is false).
# Email uses the Gmail API only when LEAD_NOTIFY_EMAIL=true AND the Gmail
# OAuth vars below are set. Leave the flag false until a controlled test.
LEAD_NOTIFY_SLACK=false
LEAD_NOTIFY_EMAIL=false

# Inserts use the service role. Hosted functions already provide
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY. SUPABASE_SERVICE_KEY is the
# alternate name. Never copy either into a VITE_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=

# Slack #inbound-alerts, live-verified private channel. Unused until send exists.
SLACK_INBOUND_ALERTS_CHANNEL_ID=C0BJZD8LNPM
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# Set from vault contact 3289329 at deploy time. Do not treat a chat label as final.
LEAD_NOTIFY_EMAIL_TO=

# contact@akwmarketing.com Gmail API. Not Resend and not SMTP.
# The parent connector user-Gmail--contact-akwmarketing-com is not available
# inside this function. Copy that mailbox's OAuth client id, client secret,
# and refresh token into these names. Do not invent or paste values here.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=contact@akwmarketing.com
