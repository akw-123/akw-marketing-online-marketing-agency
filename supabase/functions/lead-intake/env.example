# Names only. Do not put secret values in this file or in git.
# Set secrets with: supabase secrets set --project-ref hzllfwqnsiirlwacaitt NAME=value
# The Turnstile secret stays on the workstation. Do not paste it here.

# Required before a real browser POST can pass the bot check.
# Absent value makes the handler return turnstile_unconfigured and store nothing.
TURNSTILE_SECRET_KEY=

# Both default off. Setting either to true still does not send.
LEAD_NOTIFY_SLACK=false
LEAD_NOTIFY_EMAIL=false

# Documented targets. Unused while the flags above are false and while send
# code is not implemented.
# Slack channel #inbound-alerts, documented id C0BJZD8LNPM (live check still open).
SLACK_INBOUND_ALERTS_CHANNEL_ID=C0BJZD8LNPM
SLACK_BOT_TOKEN=
LEAD_NOTIFY_EMAIL_TO=andre@akwmarketing.com
