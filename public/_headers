# Phase 1 preview only. Remove this file before any production DNS cutover.
# *.pages.dev already sends X-Robots-Tag: noindex. This rule makes noindex explicit
# on every static response from this build, including the SPA shell.
/*
  X-Robots-Tag: noindex

# Real XML sitemap. Repeat noindex so this more specific rule keeps the preview header.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex
