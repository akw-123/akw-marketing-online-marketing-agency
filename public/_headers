# www.akwmarketing.com is the canonical host and is indexable.
# The bare domain 301s to www outside this repo.
# robots.txt is shared by every host, so it allows crawling. pages.dev stays
# out of the index because these rules are host-scoped.
#
# Cloudflare Pages _headers: a placeholder (:name) matches one host label,
# and a URL may contain only one splat. Docs:
# https://developers.cloudflare.com/pages/configuration/headers/
# https://akwmarketing.pages.dev/*  ->  https://:project.pages.dev/*
# https://<id>.akwmarketing.pages.dev/*  ->  https://:preview.:project.pages.dev/*
# Preview deployment URLs also get X-Robots-Tag: noindex from Pages itself.

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:preview.:project.pages.dev/*
  X-Robots-Tag: noindex
