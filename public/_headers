# Phase 1 preview only. Remove this file before any production DNS cutover.
# *.pages.dev already sends X-Robots-Tag: noindex. These rules make noindex explicit
# on every static response from this build, including prerendered HTML and sitemap.xml.
/*
  X-Robots-Tag: noindex

# A more specific rule replaces the wildcard for this path, so noindex is repeated.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex
